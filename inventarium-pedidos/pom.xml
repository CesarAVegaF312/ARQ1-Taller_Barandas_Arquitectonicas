<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Hereda las versiones de Spring Boot 3 (dependencias y plugins, incluido
       Surefire 3.x, que ejecuta pruebas JUnit 5 sin configuracion adicional). -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>co.edu.sabana.inventarium</groupId>
  <artifactId>inventarium-pedidos</artifactId>
  <version>1.0-SNAPSHOT</version>
  <name>inventarium-pedidos</name>
  <description>Taller Barandas arquitectonicas - ARQ1 - Pedidos de Inventarium con arquitectura hexagonal</description>

  <properties>
    <!-- Se compila para Java 17 aunque el JDK instalado sea mas nuevo. -->
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <archunit.version>1.5.1</archunit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- JUnit 5, AssertJ, Mockito, MockMvc y el soporte de pruebas de Spring. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- ArchUnit: convierte las reglas de arquitectura en pruebas ejecutables
         (fitness functions). Analiza el bytecode compilado, no el codigo fuente. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
